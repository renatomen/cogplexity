{
  "name": "cogplexity",
  "version": "0.0.1",
  "description": "Licence-clean ESLint rule for cognitive complexity (G. Ann Campbell's specification) on TypeScript, JavaScript and Svelte. One rule, zero runtime dependencies, no build step.",
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin",
    "cognitive-complexity",
    "complexity",
    "svelte",
    "typescript"
  ],
  "license": "MIT",
  "author": "Renato Mendonca",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/renatomen/cogplexity.git"
  },
  "homepage": "https://github.com/renatomen/cogplexity#readme",
  "bugs": "https://github.com/renatomen/cogplexity/issues",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./score": {
      "types": "./src/score.d.ts",
      "default": "./src/score.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE",
    "PROVENANCE.md"
  ],
  "scripts": {
    "test": "node --test \"test/**/*.test.js\" \"scripts/*.test.js\"",
    "lint": "eslint .",
    "typecheck": "tsc -p test/types/tsconfig.json",
    "audit:dev": "npm audit --audit-level=high",
    "pack:check": "node scripts/pack-check.mjs",
    "calibrate": "node --test test/calibration/calibrate.test.js"
  },
  "peerDependencies": {
    "@typescript-eslint/parser": "^8.44.0",
    "eslint": "^9.15.0 || ^10.0.0",
    "svelte-eslint-parser": "^1.3.3"
  },
  "peerDependenciesMeta": {
    "@typescript-eslint/parser": {
      "optional": true
    },
    "svelte-eslint-parser": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@typescript-eslint/parser": "8.69.0",
    "eslint": "9.39.5",
    "svelte": "5.57.0",
    "svelte-eslint-parser": "1.8.1",
    "typescript": "5.9.3"
  }
}
